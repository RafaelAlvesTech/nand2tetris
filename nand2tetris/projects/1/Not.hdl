// File name: projects/1/Not.hdl
/**
 * Not gate:
 * if (in) out = 0, else out = 1
 */
 //// Construct chip not using nand gates
CHIP Not {
    IN in;  // input
    OUT out; 

    

    PARTS:
    //// Construct chip not using nand gates
    Nand(a=in, b=in, out=out); // out = nand(in, in) = not(in)
    // Nand(a=in, b=in, out=out); // out = nand(in, in) = not(in)
    

}
